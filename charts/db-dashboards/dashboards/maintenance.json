{
  "uid": "dbaas-maintenance",
  "title": "Maintenance",
  "description": "Watch this during a rotation: cordons, kubelet versions, switchovers, refusals, canary failures.",
  "tags": [
    "dbaas"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "namespace",
        "label": "Instance namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(db_canary_write_total, namespace)",
          "refId": "ns"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "definition": "label_values(db_canary_write_total, namespace)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cordoned nodes",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (label_dbaas_local_node_class) (kube_node_spec_unschedulable)",
          "legendFormat": "{{label_dbaas_local_node_class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Kubelet version per node",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_node_info",
          "legendFormat": "{{node}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Instances with a blocked drain",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "drain_guard_blocked_instances",
          "legendFormat": "blocked",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Evacuations and refused evictions",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(drain_guard_evacuations_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (rate(drain_guard_evictions_denied_total[5m]))",
          "legendFormat": "denied {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Allowed disruptions per instance",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_poddisruptionbudget_status_pod_disruptions_allowed{namespace=~\"db-.*\"}",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Canary write failures during maintenance",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (namespace) (increase(db_canary_write_total{result=\"error\",namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ]
    }
  ],
  "links": [],
  "annotations": {
    "list": []
  }
}
