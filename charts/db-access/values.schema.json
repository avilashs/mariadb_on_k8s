{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "db-access values",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "stage"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,28}[a-z0-9]$"},
    "stage": {"enum": ["users", "grants"]},
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "owner"],
        "properties": {
          "name": {"type": "string"},
          "owner": {"type": "string"}
        }
      }
    },
    "readers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "secret", "databases"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$"},
          "secret": {"type": "string", "minLength": 1},
          "databases": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,30}$"}}
        }
      }
    }
  }
}
