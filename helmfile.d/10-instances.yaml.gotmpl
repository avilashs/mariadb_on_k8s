# One release pair per instance file (PLAN.md phase 4).
#
#   ENV=kind helmfile -f helmfile.d/10-instances.yaml.gotmpl sync
#
# Every file in environments/$ENV/instances/ is an instance. Adding a file adds an
# instance; deleting a file does NOT delete it. Helmfile never removes a release it
# no longer sees. Removal is the documented two-step procedure (docs/operations.md):
# scripts/instance-remove.sh.
#
# INSTANCES_DIR overrides the directory (the e2e suites use it to model a removal).
# The platform (00-platform) must already be installed.
#
# Stages, run in order by hack/instances-up.sh, each one waited on before the next:
# namespaces, credentials Secrets, instances, users, grants. The stage is the
# label stage=<name> on each release.
{{- $env := requiredEnv "ENV" }}
{{- $platform := readFile (printf "../environments/%s/platform.yaml" $env) | fromYaml }}
{{- $dir := env "INSTANCES_DIR" | default (printf "../environments/%s/instances" $env) }}
{{- $catalogue := dict "storageTiers" $platform.storageTiers "storageClasses" $platform.storageClasses "nodeClasses" $platform.nodeClasses "backupStore" $platform.backupStore }}
{{- $files := readDir $dir }}

helmDefaults:
  kubeContext: {{ $platform.kubeContext | quote }}
  wait: true
  waitForJobs: true
  timeout: 600
  historyMax: 5
  createNamespace: false

releases:
{{- range $file := $files }}
{{- if hasSuffix ".yaml" $file }}
{{- $inst := readFile $file | fromYaml }}
{{- $name := $inst.name | required (printf "%s: name is required" $file) }}
{{- if not (has $inst.engine (list "mariadb" "postgres")) }}
{{- fail (printf "%s: engine %q is not available" $file $inst.engine) }}
{{- end }}
  # Namespace first, from the db-namespace chart. Its release record lives in default,
  # because the namespace it creates does not exist yet.
  - name: ns-{{ $name }}
    namespace: default
    chart: ../charts/db-namespace
    labels:
      stage: namespace
    values:
      - {{ dict "name" $name "engine" $inst.engine "quota" (index $inst "quota" | default dict) | toJson }}

{{- if eq $inst.engine "mariadb" }}
  - name: {{ $name }}
    namespace: db-{{ $name }}
    chart: ../charts/mariadb-instance
    labels:
      stage: instance
    needs:
      - default/ns-{{ $name }}
    values:
      - {{ merge (deepCopy $inst) (dict "catalogue" $catalogue) | toJson }}
{{- else }}
  # PostgreSQL: one CloudNativePG Cluster. Its databases and roles are declared in the chart.
  - name: {{ $name }}
    namespace: db-{{ $name }}
    chart: ../charts/postgres-instance
    labels:
      stage: instance
    needs:
      - default/ns-{{ $name }}
    values:
      - {{ merge (deepCopy $inst) (dict "catalogue" $catalogue) | toJson }}
{{- end }}

{{- $own := index (index $inst "access" | default dict) "databases" | default list }}
{{- /* The query optimizer add-on (charts/db-query-optimizer): opt-in per instance. It analyses one database:
       the one named in the block, else the instance's first. */}}
{{- $qo := index $inst "queryOptimizer" | default dict }}
{{- $qoOn := index $qo "enabled" | default false }}
{{- $qoDb := index $qo "database" | default (ternary (index (first $own) "name") "" (gt (len $own) 0)) }}
{{- if and $qoOn (eq $qoDb "") }}
{{- fail (printf "%s: queryOptimizer.enabled needs a database (queryOptimizer.database, or an entry in access.databases)" $file) }}
{{- end }}
{{- /* Every instance has the canary's database and user, whatever the file says (PLAN.md phase 6). */}}
{{- $databases := concat $own (list (dict "name" "dbaas_canary" "owner" "canary")) }}
{{- if eq $inst.engine "mariadb" }}
  # Users, then grants: a grant on a user that does not exist yet backs off for a long time.
  - name: {{ $name }}-users
    namespace: db-{{ $name }}
    chart: ../charts/db-access
    labels:
      stage: users
    needs:
      - db-{{ $name }}/{{ $name }}
    values:
      - {{ dict "name" $name "stage" "users" "databases" $databases "readers" (ternary (list (dict "name" "qopt_reader" "secret" (printf "%s-qopt-credentials" $name) "databases" (list $qoDb))) (list) $qoOn) | toJson }}

  - name: {{ $name }}-grants
    namespace: db-{{ $name }}
    chart: ../charts/db-access
    labels:
      stage: grants
    needs:
      - db-{{ $name }}/{{ $name }}-users
    values:
      - {{ dict "name" $name "stage" "grants" "databases" $databases "readers" (ternary (list (dict "name" "qopt_reader" "secret" (printf "%s-qopt-credentials" $name) "databases" (list $qoDb))) (list) $qoOn) | toJson }}
{{- end }}

  # The canary measures the instance from a client's side (PLAN.md phase 6). It waits for
  # its role: the grants for MariaDB, the Cluster for PostgreSQL.
  - name: {{ $name }}-canary
    namespace: db-{{ $name }}
    chart: ../charts/db-canary
    labels:
      stage: canary
    needs:
{{- if eq $inst.engine "mariadb" }}
      - db-{{ $name }}/{{ $name }}-grants
{{- else }}
      - db-{{ $name }}/{{ $name }}
{{- end }}
    values:
      - {{ dict "name" $name "engine" $inst.engine "image" (env "CANARY_IMAGE" | default "dbaas/db-canary:dev") "imagePullSecrets" (dig "registry" "pullSecrets" (list) $platform) "replicas" (dig "systemReplicas" 2 $platform) "user" (ternary "canary" "canary" true) "database" "dbaas_canary" "port" (ternary 3306 5432 (eq $inst.engine "mariadb")) "caSecret" (printf "%s-ca%s" $name (ternary "-bundle" "" (eq $inst.engine "mariadb"))) | toJson }}
{{- if $qoOn }}

  # The query optimizer (PLAN.md add-on): notify-only unless the block says godMode. It needs its account:
  # the grants for MariaDB, the Cluster (which declares the role) for PostgreSQL.
  - name: {{ $name }}-qopt
    namespace: db-{{ $name }}
    chart: ../charts/db-query-optimizer
    labels:
      stage: optimizer
    needs:
{{- if eq $inst.engine "mariadb" }}
      - db-{{ $name }}/{{ $name }}-grants
{{- else }}
      - db-{{ $name }}/{{ $name }}
{{- end }}
    values:
      - {{ merge (dict "name" $name "engine" $inst.engine "database" $qoDb "image" (env "QOPT_IMAGE" | default "dbaas/query-optimizer:dev") "imagePullSecrets" (dig "registry" "pullSecrets" (list) $platform)) (omit (deepCopy $qo) "enabled" "database") | toJson }}
{{- end }}
{{- end }}
{{- end }}
