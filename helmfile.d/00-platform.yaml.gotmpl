# Installs the platform components for one environment (PLAN.md phase 1).
#
#   ENV=kind helmfile -f helmfile.d/00-platform.yaml.gotmpl sync
#
# Inputs:
#   environments/$ENV/platform.yaml              required: clouds, classes, toggles
#   environments/$ENV/kube-prometheus-stack.yaml required: overrides, may be empty
# Pins come from versions.yaml only. Order is enforced with `needs`: the platform
# base comes first, because it creates the priority classes and namespaces that
# every other release uses.
{{- $env := requiredEnv "ENV" }}
{{- $platform := readFile (printf "../environments/%s/platform.yaml" $env) | fromYaml }}
{{- $versions := readFile "../versions.yaml" | fromYaml }}
{{- $platformVersions := $versions.platform }}
{{- $mariadbOperator := $versions.operators.mariadb }}
{{- $base := list "default/db-platform-base" }}

helmDefaults:
  kubeContext: {{ $platform.kubeContext | quote }}
  wait: true
  waitForJobs: true
  timeout: 600
  historyMax: 5
  createNamespace: false

releases:
  # The release record lives in default because this release creates the
  # namespaces (dbaas-system, monitoring) that other releases use. Helm cannot
  # store a release in a namespace that does not exist yet.
  - name: db-platform-base
    namespace: default
    chart: ../charts/db-platform-base
    values:
      - {{ dict "storageTiers" $platform.storageTiers "storageClasses" $platform.storageClasses "nodeClasses" $platform.nodeClasses "namespaces" $platform.namespaces | toJson }}

  - name: cert-manager
    namespace: cert-manager
    createNamespace: true
    chart: {{ $platformVersions.certManager.chart }}
    version: {{ $platformVersions.certManager.version | quote }}
    needs: {{ toJson $base }}
    values:
      - {{ dict "crds" (dict "enabled" true) "global" (dict "priorityClassName" "dbaas-platform") "nodeSelector" (dict "pool" "system") "webhook" (dict "nodeSelector" (dict "pool" "system")) "cainjector" (dict "nodeSelector" (dict "pool" "system")) | toJson }}

  - name: mariadb-operator-crds
    namespace: mariadb-system
    createNamespace: false
    chart: {{ $mariadbOperator.crdsChart }}
    version: {{ $mariadbOperator.version | quote }}
    needs: {{ toJson $base }}

  - name: mariadb-operator
    namespace: mariadb-system
    createNamespace: false
    chart: {{ $mariadbOperator.chart }}
    version: {{ $mariadbOperator.version | quote }}
    needs:
      - mariadb-system/mariadb-operator-crds
    values:
      - values/mariadb-operator.yaml
      - {{ dict "ha" (dict "replicas" (dig "systemReplicas" 2 $platform)) "webhook" (dict "ha" (dict "replicas" (dig "systemReplicas" 2 $platform))) "certController" (dict "ha" (dict "replicas" (dig "systemReplicas" 2 $platform))) | toJson }}

{{- if eq (dig "monitoring" "install" false $platform) true }}
  - name: {{ dig "monitoring" "prometheusRelease" "kube-prometheus-stack" $platform }}
    namespace: monitoring
    chart: {{ $platformVersions.kubePrometheusStack.chart }}
    version: {{ $platformVersions.kubePrometheusStack.version | quote }}
    needs: {{ toJson $base }}
    values:
      - values/kube-prometheus-stack.yaml
      - ../environments/{{ $env }}/kube-prometheus-stack.yaml
{{- end }}

{{- if eq (dig "testObjectStore" "install" false $platform) true }}
  - name: test-object-store
    namespace: object-store
    createNamespace: true
    chart: ../charts/test-object-store
    needs: {{ toJson $base }}
    values:
      - {{ dict "bucket" (dig "testObjectStore" "bucket" "dbaas-test" $platform) "nodeSelector" (dict "pool" "system") "priorityClassName" "dbaas-platform" | toJson }}
{{- end }}

  # PostgreSQL: the CloudNativePG operator and the Barman Cloud plugin (PLAN.md phase 10).
  # The plugin needs cert-manager for its certificates.
  - name: cloudnative-pg
    namespace: cnpg-system
    createNamespace: true
    chart: {{ $versions.operators.postgres.chart }}
    version: {{ $versions.operators.postgres.chartVersion | quote }}
    needs: {{ toJson $base }}
    values:
      - values/cloudnative-pg.yaml
      - {{ dict "replicaCount" (dig "systemReplicas" 2 $platform) | toJson }}

  - name: barman-cloud
    namespace: cnpg-system
    createNamespace: false
    chart: {{ $versions.operators.postgres.barmanCloudPlugin.chart }}
    version: {{ $versions.operators.postgres.barmanCloudPlugin.chartVersion | quote }}
    needs:
      - default/db-platform-base
      - cert-manager/cert-manager
      - cnpg-system/cloudnative-pg
    values:
      - values/barman-cloud.yaml
      - {{ dict "replicaCount" (dig "systemReplicas" 2 $platform) | toJson }}

  # The alert rules of section 7.2, as PrometheusRule objects (phase 8).
  - name: db-alerts
    namespace: monitoring
    chart: ../charts/db-alerts
    needs:
      - default/db-platform-base
{{- if eq (dig "monitoring" "install" false $platform) true }}
      - monitoring/{{ dig "monitoring" "prometheusRelease" "kube-prometheus-stack" $platform }}
{{- end }}

  # The Grafana dashboards of phase 8, provisioned into the Databases folder.
  - name: db-dashboards
    namespace: monitoring
    chart: ../charts/db-dashboards
    needs:
      - default/db-platform-base
{{- if eq (dig "monitoring" "install" false $platform) true }}
      - monitoring/{{ dig "monitoring" "prometheusRelease" "kube-prometheus-stack" $platform }}
{{- end }}

  # The weekly restore drill (PLAN.md phase 5). Its scripts are the files in scripts/.
  - name: db-restore-drill
    namespace: dbaas-system
    chart: ../charts/db-restore-drill
    needs: {{ toJson $base }}
    set:
      - name: scripts.restoreDrill
        file: ../scripts/restore-drill.sh
      - name: scripts.restoreInstance
        file: ../scripts/restore-instance.sh

  # The role-aware drain guard (PLAN.md phase 7): controller and eviction webhook.
  # It needs the certificates of cert-manager, so it comes after it.
  - name: drain-guard
    namespace: dbaas-system
    chart: ../charts/drain-guard
    needs:
      - default/db-platform-base
      - cert-manager/cert-manager
    values:
      - {{ dict "image" (dig "drainGuard" "image" "dbaas/drain-guard:dev" $platform) "replicas" (dig "drainGuard" "replicas" 3 $platform) "drainTaintKeys" (dig "drainGuard" "drainTaintKeys" (list) $platform) "imagePullSecrets" (dig "registry" "pullSecrets" (list) $platform) | toJson }}

{{- if eq (dig "localNvme" "driver" "none" $platform) "helm" }}
  - name: local-csi-driver
    namespace: kube-system
    chart: {{ $platformVersions.localCsiDriver.chart }}
    version: {{ $platformVersions.localCsiDriver.version | quote }}
    needs: {{ toJson $base }}
{{- end }}
